# Copy to .env and edit. .env is git-ignored; never commit real keys.

# --- Local model server (on the host) ---------------------------------------
# Preset fills provider name, base URL and API type. Available: omlx
LOCAL_LLM_PRESET=omlx
# Model IDs as the server lists them at /v1/models (comma-separated).
# The first one becomes the default model.
LOCAL_LLM_MODELS=Qwen3.8-27B-MLX-4bit
# oMLX requires an API key (set in oMLX's settings). Leave empty if your
# server needs none.
LOCAL_LLM_API_KEY=

# Optional overrides of the preset:
# LOCAL_LLM_PROVIDER=omlx
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
# LOCAL_LLM_API=openai-completions
# LOCAL_LLM_CONTEXT_WINDOW=32768
# LOCAL_LLM_MAX_TOKENS=8192

# --- pi settings ---------------------------------------------------------------
# Default model if not the first of LOCAL_LLM_MODELS.
# PI_DEFAULT_MODEL=
# true (default): regenerate models.json from the variables above on every
# start. false: keep a models.json you manage yourself in the pi-agent volume.
# PI_MODELS_MANAGED=true
# true: reset the default provider/model in settings.json on every start.
# PI_SETTINGS_FORCE_DEFAULT_MODEL=false

# --- Browser GUI ---------------------------------------------------------------
# Port on the host: http://localhost:${HOST_PORT}
HOST_PORT=14567
# Keep at 127.0.0.1 so only this machine can reach the GUI (it has no login).
# BIND_ADDRESS=127.0.0.1

# --- Host folders instead of named volumes (with compose.bind.yaml) ----------
# OPENCANDLE_DATA_DIR=./data/opencandle
# PI_AGENT_DIR=./data/pi-agent
# WORKSPACE_DIR=./data/workspace
# HOME_DIR=./data/home

# --- Image build ---------------------------------------------------------------
# Container user ids; on Linux with bind mounts use your own `id -u` / `id -g`.
# APP_UID=1000
# APP_GID=1000

# --- Optional financial data providers (deeper coverage) ---------------------
# ALPHA_VANTAGE_API_KEY=
# FRED_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# FINNHUB_API_KEY=
# LSE_API_KEY=
# OPENCANDLE_ROUTER_MODE=

# --- Optional cloud model fallback -------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
